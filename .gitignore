# Bazel convenience symlinks (bazel-bin, bazel-out, bazel-cppgpt, bazel-testlogs)
/bazel-*

# Per-user Bazel overrides (machine-local, never checked in)
/user.bazelrc

# MODULE.bazel.lock IS committed (pins transitive deps + registry hashes for
# reproducible resolution) — do not ignore it.

# Python notebook environment (uv-managed venv for notebooks/; machine-local).
# Reproduced from notebooks/requirements.txt — never checked in.
/.venv/

# Jupyter checkpoint scratch
**/.ipynb_checkpoints/

# Editor settings with machine-local absolute paths (interpreter location).
.vscode/

# Corpora, tokenized splits and checkpoints are local artifacts, never committed.
/data/

# Generated static site for local/Funnel serving (tools/make-site.sh).
/site/
