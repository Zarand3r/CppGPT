# CLI tools: train (train + checkpoint), prepare (corpus -> uint16 .bin +
# .vocab), generate (train + sample text). Fixture verification is a test
# (//tests/integration:parity_test), not a tool.
load("@rules_cc//cc:defs.bzl", "cc_binary")

package(default_visibility = ["//visibility:private"])

cc_binary(
    name = "train",
    srcs = ["train.cpp"],
    deps = ["//:cppgpt"],
)

cc_binary(
    name = "generate",
    srcs = ["generate.cpp"],
    deps = ["//:cppgpt"],
)

cc_binary(
    name = "prepare",
    srcs = ["prepare.cpp"],
    deps = ["//:cppgpt"],
)
