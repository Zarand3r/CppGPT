# CLI tools: prepare (corpus -> uint16 .bin + .vocab), train (train/resume/
# fine-tune + checkpoint), generate (load a checkpoint and sample). Fixture
# verification is a test (//tests/integration:parity_test), not a tool.
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")

# Binaries are private except to //tests, which runs them end to end.
package(default_visibility = ["//tests:__subpackages__"])

# Shared argv parsing for the CLI tools. Three tools take flags; the load-bearing
# behavior is reject_unknown() — a mistyped flag must be an error, never a silent
# no-op that trains the wrong model.
cc_library(
    name = "cli",
    hdrs = ["cli.hpp"],
    visibility = ["//tests:__subpackages__"],
)

cc_binary(
    name = "train",
    srcs = ["train.cpp"],
    deps = [
        ":cli",
        "//:cppgpt",
    ],
)

cc_binary(
    name = "generate",
    srcs = ["generate.cpp"],
    deps = [
        ":cli",
        "//:cppgpt",
    ],
)

cc_binary(
    name = "prepare",
    srcs = ["prepare.cpp"],
    deps = [
        ":cli",
        "//:cppgpt",
    ],
)

cc_binary(
    name = "bench",
    srcs = ["bench.cpp"],
    deps = ["//:cppgpt"],
)

# How long one forward pass takes: the budget for every interactive
# interpretability question, since ablation and patching each cost one.
cc_binary(
    name = "profile",
    srcs = ["profile.cpp"],
    deps = [
        ":cli",
        "//:cppgpt",
    ],
)

cc_binary(
    name = "inspect",
    srcs = ["inspect.cpp"],
    deps = [
        ":cli",
        "//:cppgpt",
    ],
)
