# CLI tools: train (train + checkpoint), prepare (corpus -> uint16 .bin +
# .vocab), generate (train + sample text). Fixture verification is a test
# (//tests/integration:parity_test), not a tool.
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")

package(default_visibility = ["//visibility:private"])

# Shared argv parsing for the CLI tools. Three tools take flags; the load-bearing
# behavior is reject_unknown() — a mistyped flag must be an error, never a silent
# no-op that trains the wrong model.
cc_library(
    name = "cli",
    hdrs = ["cli.hpp"],
    visibility = ["//tests:__subpackages__"],
)

cc_binary(
    name = "train",
    srcs = ["train.cpp"],
    deps = [
        ":cli",
        "//:cppgpt",
    ],
)

cc_binary(
    name = "generate",
    srcs = ["generate.cpp"],
    deps = ["//:cppgpt"],
)

cc_binary(
    name = "prepare",
    srcs = ["prepare.cpp"],
    deps = [
        ":cli",
        "//:cppgpt",
    ],
)

cc_binary(
    name = "bench",
    srcs = ["bench.cpp"],
    deps = ["//:cppgpt"],
)
