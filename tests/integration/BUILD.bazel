load("@rules_cc//cc:defs.bzl", "cc_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

# Integration tests compose multiple ops and verify they wire together (forward
# and backward) — distinct from the per-op unit tests under tests/unit.
cc_test(
    name = "transformer_block_test",
    size = "small",
    srcs = ["transformer_block_test.cpp"],
    deps = [
        "//:cppgpt",
        "//tests:check",
        "//tests:numeric",
    ],
)

cc_test(
    name = "generate_test",
    size = "small",
    srcs = ["generate_test.cpp"],
    deps = [
        "//:cppgpt",
        "//tests:check",
    ],
)

cc_test(
    name = "prepare_dataloader_test",
    size = "small",
    srcs = ["prepare_dataloader_test.cpp"],
    deps = [
        "//:cppgpt",
        "//tests:check",
    ],
)

# M1 gate: cppgpt vs canonical GPT-2 in PyTorch, via a committed reference fixture.
cc_test(
    name = "parity_test",
    size = "small",
    srcs = ["parity_test.cpp"],
    data = ["//tests/fixtures:gpt2_parity.bin"],
    deps = [
        "//:cppgpt",
        "//tests:check",
    ],
)

# The only test that runs the actual CLI binaries. Every other test links the
# library directly, so the tools' own wiring (flag parsing, the vocab-sidecar path
# rule, reading a model's shape from a checkpoint header) had no coverage — and two
# real defects had already slipped through that gap.
sh_test(
    name = "e2e_pipeline_test",
    size = "small",
    srcs = ["e2e_pipeline_test.sh"],
    data = [
        "//tools:generate",
        "//tools:prepare",
        "//tools:train",
    ],
)
