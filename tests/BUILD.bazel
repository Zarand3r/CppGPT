load("@rules_cc//cc:defs.bzl", "cc_library")

# Header-only std-only test harness, included as "tests/check.hpp".
cc_library(
    name = "check",
    hdrs = ["check.hpp"],
    visibility = ["//visibility:public"],
)

# Numeric helpers (dot, rel_close, finite-difference grad_check) for op tests.
cc_library(
    name = "numeric",
    hdrs = ["numeric.hpp"],
    visibility = ["//visibility:public"],
)

# Fixture loader for the PyTorch parity gate. TEST-ONLY: it was in
# include/cppgpt/ and shipped as public library API with zero library or tool
# callers, which ROADMAP.md had flagged. It also sizes allocations from an
# unvalidated file header, which is acceptable for a committed test fixture and
# was not acceptable in the library surface.
cc_library(
    name = "verify",
    hdrs = ["verify.hpp"],
    visibility = ["//tests:__subpackages__"],
)
