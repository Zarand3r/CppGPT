# Committed PyTorch reference fixtures (regenerated by scripts/gen_fixtures.py in
# the torch venv). Consumed as `data` by the parity gate test.
exports_files(["gpt2_parity.bin", "interpret_golden.txt"])

# GPT-2's tokenizer, committed so the differential gate is hermetic: CLAUDE.md
# requires `bazel test //...` to be green on a clean checkout, and a test that
# downloads 1.4 MB first is not. These files are immutable -- GPT-2 is frozen.
filegroup(
    name = "gpt2_tokenizer",
    srcs = ["gpt2/vocab.json", "gpt2/merges.txt"],
    visibility = ["//tests:__subpackages__"],
)

filegroup(
    name = "bpe_gpt2",
    srcs = ["bpe_gpt2.bin"],
    visibility = ["//tests:__subpackages__"],
)
