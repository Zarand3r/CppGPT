load("@rules_cc//cc:defs.bzl", "cc_library")

# The cppgpt library, in TWO layers. Warning flags (-Wall -Wextra -Wpedantic
# -Werror) come from .bazelrc globally.
#
#   cppgpt_model   — train, inference, load. What the model IS.
#   cppgpt_interp  — the interpretability layer: logit lens, direct logit
#                    attribution, KL, ablation, donor capture, and the helpers
#                    for indexing the activation arena by layer and head.
#
# The interpretability layer reads the model. The model must never reach the
# interpretability layer. That direction used to be convention only, and a probe
# showed convention was all it was: adding `#include "cppgpt/interpret.hpp"` to
# src/model.cpp compiled clean under a single glob()'d target, and
# `bazel test //...` was green either way. Split this way Bazel enforces it —
# interpret.hpp is not among cppgpt_model's headers, so any model file reaching
# for it fails to compile.
#
# THE ONE THING IN cppgpt_model THAT IS NOT TRAIN/INFER/LOAD is patch.hpp. It
# has to be here: GPT2::forward calls apply_patch, so model.cpp compiles against
# that type no matter which target owns the header, and putting it in
# cppgpt_interp would make the model depend on the layer that depends on it.
# The alternative — a duplicate forward loop inside interpret.cpp — was rejected
# because it creates a second numerical truth in a repo built on parity.
#
# So patch.hpp is a deliberate, bounded exception rather than a definition of
# "core", and it is kept as small as a thing can be: an enum, a POD, and three
# functions whose whole body is memcpy and asserts. It knows nothing about GPT2.
# See docs/DECISIONS.md D10.
cc_library(
    name = "cppgpt_model",
    srcs = glob(["src/**/*.cpp"], exclude = ["src/interpret.cpp"]),
    hdrs = glob(["include/cppgpt/**/*.hpp"], exclude = ["include/cppgpt/interpret.hpp"]),
    strip_include_prefix = "include",
    visibility = ["//visibility:public"],
)

cc_library(
    name = "cppgpt_interp",
    srcs = ["src/interpret.cpp"],
    hdrs = ["include/cppgpt/interpret.hpp"],
    strip_include_prefix = "include",
    visibility = ["//visibility:public"],
    deps = [":cppgpt_model"],
)

# Umbrella, so every existing consumer keeps working unchanged. Code that wants
# the guarantee "this cannot reach interpretability" depends on :cppgpt_model.
cc_library(
    name = "cppgpt",
    visibility = ["//visibility:public"],
    deps = [
        ":cppgpt_interp",
        ":cppgpt_model",
    ],
)
