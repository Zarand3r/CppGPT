# cppgpt — Bazel configuration.

# bzlmod only (Bazel 9 default; stated explicitly so a stray WORKSPACE is ignored).
common --noenable_workspace

# Language standard per PLAN.md (C++23 — for std::expected, used by Result<T,E>).
build --cxxopt=-std=c++23
build --host_cxxopt=-std=c++23

# Build hygiene (PLAN.md): warnings are errors. Safe to apply globally because
# the repo compiles no third-party C++ sources — rules_cc / toolchains_llvm
# provide prebuilt inputs, and toolchain/libc++ headers are treated as system
# headers (so warnings there are suppressed).
build --cxxopt=-Wall
build --cxxopt=-Wextra
build --cxxopt=-Wpedantic
build --cxxopt=-Werror

# --- config=release: optimized. See docs/DECISIONS.md D1 for the flag choice. ---
build:release --compilation_mode=opt
build:release --cxxopt=-O3
# Explicit ISA baseline, not -march=native: native measured no faster (2.87 vs 2.95
# GFLOP/s) while making every binary depend on the build host, which contradicts the
# hermetic-toolchain premise. v3 = AVX2 + FMA (Haswell 2013+ / Zen 1+).
build:release --cxxopt=-march=x86-64-v3
# The dominant matmul is a serial `acc += a*b` reduction; clang's default
# -ffp-contract=fast fuses it into one vfmadd and serializes on FMA latency.
# Disabling contraction is ~2x on that kernel (2.95 -> 5.82 GFLOP/s) and keeps the
# canonical-GPT-2 parity gate at ~50x margin. Revisit once the matmul uses multiple
# accumulators -- contraction should become a win again.
build:release --cxxopt=-ffp-contract=off

# --- config=dev: PLAN.md "-O1 -g -fsanitize=address,undefined". ---
build:dev --compilation_mode=fastbuild
build:dev --cxxopt=-O1
build:dev --cxxopt=-g
build:dev --cxxopt=-fno-omit-frame-pointer
build:dev --cxxopt=-fsanitize=address,undefined
build:dev --linkopt=-fsanitize=address,undefined
# Disable UBSan's vptr check: it is triggered inside libc++'s <format>/<locale>
# polymorphic facets, needs RTTI + the standalone runtime (unlinked under the
# hermetic toolchain), and catches nothing in our (polymorphism-free) code.
build:dev --cxxopt=-fno-sanitize=vptr
# Make sanitizer findings fatal so tests actually fail on ASan/UBSan hits.
test:dev --test_env=UBSAN_OPTIONS=halt_on_error=1:print_stacktrace=1
test:dev --test_env=ASAN_OPTIONS=halt_on_error=1

# Readable test output.
test --test_output=errors

# Per-user machine-local overrides (git-ignored), if present.
try-import %workspace%/user.bazelrc

# Sanitizers. Previously these had to be passed as raw --copt/--linkopt on the
# command line, which meant every invocation spelled them differently and one
# run silently reused cached results from a non-sanitized build.
build:asan --config=dev
build:asan --copt=-fsanitize=address,undefined --copt=-fno-omit-frame-pointer --copt=-g
# vptr needs RTTI, which this build does not use; without excluding it the link
# fails on __ubsan_vptr_type_cache rather than on anything wrong with the code.
build:asan --copt=-fno-sanitize=vptr --linkopt=-fno-sanitize=vptr
build:asan --linkopt=-fsanitize=address,undefined
build:asan --test_env=ASAN_OPTIONS=detect_leaks=0
build:asan --test_env=UBSAN_OPTIONS=print_stacktrace=1:halt_on_error=1
